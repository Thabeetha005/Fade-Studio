---
import { SALON_ADDRESS, SALON_HOURS, PHONE_NUMBER, PHONE_CALL_URL, SALON_EMAIL } from '../config.js';
---

<!-- ==================== FOOTER ==================== -->
<footer class="site-footer" id="siteFooter">
  <div class="footer-container">
    <div class="footer-links-grid">
      <div class="footer-col">
        <span class="footer-col-header">SERVICES & MENU</span>
        <ul class="footer-links-list">
          <li><a href="/services">All Services</a></li>
          <li><a href="/men">Men's Grooming</a></li>
          <li><a href="/women">Women's Hair & Beauty</a></li>
          <li><a href="/pricing">Full Pricing Table</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <span class="footer-col-header">EXPLORE</span>
        <ul class="footer-links-list">
          <li><a href="/gallery">Studio Gallery</a></li>
          <li><a href="/about">About & Team</a></li>
          <li><a href="/offers">Seasonal Offers</a></li>
          <li><a href="/book">Book Appointment</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <span class="footer-col-header">OPENING HOURS</span>
        <ul class="footer-links-list">
          <li style="color:#D5D2CB; font-size:12px;">{SALON_HOURS.days}</li>
          <li style="color:var(--color-gold); font-size:14px; font-weight:700;">{SALON_HOURS.time}</li>
          <li style="color:#8C8C92; font-size:11px; margin-top:8px;">Walk-ins welcome based on stylist availability. Prior booking recommended.</li>
        </ul>
      </div>

      <div class="footer-col">
        <span class="footer-col-header">STUDIO LOCATION</span>
        <p class="footer-about-text" style="color:#D5D2CB; margin-bottom:8px;">
          {SALON_ADDRESS}
        </p>
        <p style="color:#D5D2CB; font-size:12px; font-style:normal;">
          Phone: <a href={PHONE_CALL_URL} style="color:var(--color-gold);">{PHONE_NUMBER}</a><br>
          Email: <a href={`mailto:${SALON_EMAIL}`} style="color:var(--color-gold);">{SALON_EMAIL}</a>
        </p>
      </div>
    </div>

    <div class="footer-giant-logo-wrap" aria-hidden="true">
      <span class="footer-giant-logo">
        <span class="logo-fade">FADE</span>
        <span class="logo-studio">STUDIO</span>
      </span>
    </div>
  </div>
</footer>
