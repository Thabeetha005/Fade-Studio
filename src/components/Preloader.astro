<!-- ==================== PRELOADER ==================== -->
<aside id="preloader" class="preloader" aria-label="Loading FADE STUDIO" role="dialog" aria-modal="true">
  <div class="loader-container">
    <div class="loader-image-frame">
      <img
        src="/assets/hero-portrait.png"
        alt="FADE STUDIO Loading"
        class="loader-image"
      />
      
      <!-- Progress bar placed over/inside the loader image area -->
      <div class="loader-progress-overlay">
        <div class="loader-progress-track">
          <div class="loader-progress-bar" id="preloaderProgressBar"></div>
          <div class="loader-percentage-pin" id="preloaderCounterPin">
            <span class="loader-percentage-val" id="preloaderCounter">0%</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</aside>
