---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Men's Grooming — FADE STUDIO | Precision Fades & Beard Shaves"
  description="Dedicated men"
  currentPage="men"
  showPreloader={false}
>
  <main id="mainContent">

    <!-- ==================== HERO ==================== -->
    <section class="page-hero">
      <div class="page-hero-inner">
        <span class="page-kicker">MEN'S BARBERSHOP & GROOMING</span>
        <h1 class="page-hero-title">
          Grooming, <span class="italic-serif">done right.</span>
        </h1>
        <p class="page-hero-desc">
          Crafting clean silhouettes, master-grade skin fades, and meticulous beard lines. We build each haircut around your head shape, hair density, and daily routine.
        </p>
        <div class="page-hero-cta">
          <a href="/book" class="btn btn-charcoal">Reserve a Barber Chair</a>
          <a href="#consultation-steps" class="btn btn-outline">Our 3-Step Process</a>
        </div>
      </div>
    </section>

    <!-- ==================== SECTION 1: HAIRCUTS & FADES ==================== -->
    <section class="content-section" id="cuts-fades">
      <div class="section-header-block">
        <span class="section-kicker">DISCIPLINE 01</span>
        <h2 class="section-title">Haircuts & <span class="italic-serif">Precision Fades</span></h2>
        <p class="section-desc">From clean low tapers and mid drop fades to classic tailored scissor work.</p>
      </div>

      <div class="service-groups-grid">
        <div class="service-category-card">
          <div>
            <div class="card-cat-title">
              <span>Signature Haircuts</span>
              <span class="tag">ESSENTIAL</span>
            </div>
            <ul class="price-item-list">
              <li class="price-item">
                <div>
                  <span class="price-name">Classic Haircut</span>
                  <p class="form-help">Scissor or clipper cut, tapered neckline, wash & matte clay styling.</p>
                </div>
                <span class="price-amount">₹300</span>
              </li>
              <li class="price-item">
                <div>
                  <span class="price-name">Skin Fade / Taper Fade</span>
                  <p class="form-help">Razor-blended zero fade, foil shaver finish, crisp temple lineup.</p>
                </div>
                <span class="price-amount">₹400</span>
              </li>
              <li class="price-item">
                <div>
                  <span class="price-name">Haircut + Beard Ritual</span>
                  <p class="form-help">Our most popular combination. Complete cut, beard trim, razor outline.</p>
                </div>
                <span class="price-amount">₹550</span>
              </li>
              <li class="price-item">
                <div>
                  <span class="price-name">Kids Cut</span>
                  <p class="form-help">Gentle, patient styling for young gentlemen aged 12 and under.</p>
                </div>
                <span class="price-amount">₹250</span>
              </li>
              <li class="price-item">
                <div>
                  <span class="price-name">Hair Wash, Conditioning & Style</span>
                  <p class="form-help">Deep clarifying rinse, scalp refresh, blow-dry and product application.</p>
                </div>
                <span class="price-amount">₹200</span>
              </li>
            </ul>
          </div>
          <div class="service-card-action">
            <a href="/book?service=Skin+Fade" class="btn btn-charcoal" style="width:100%;">Book a Cut</a>
          </div>
        </div>

        <div class="service-category-card" style="padding:0; overflow:hidden; background:var(--color-charcoal-dark);">
          <img loading="lazy" decoding="async" src="/assets/men-1.jpg" alt="Precision fade haircut at FADE STUDIO" style="width:100%; height:100%; object-fit:cover;">
        </div>
      </div>
    </section>

    <!-- ==================== SECTION 2: BEARD & SHAVE (THEME DARK) ==================== -->
    <section class="content-section theme-dark" id="beard-shave">
      <div class="section-header-block">
        <span class="section-kicker">DISCIPLINE 02</span>
        <h2 class="section-title">Beard Architecture & <span class="italic-serif">Hot Towel Shave</span></h2>
        <p class="section-desc">Traditional straight-edge techniques paired with sandalwood balms and botanical pre-shave oils.</p>
      </div>

      <div class="service-groups-grid">
        <div class="service-category-card" style="padding:0; overflow:hidden;">
          <img loading="lazy" decoding="async" src="/assets/men-5.jpg" alt="Traditional hot towel shave finish" style="width:100%; height:100%; object-fit:cover;">
        </div>

        <div class="service-category-card">
          <div>
            <div class="card-cat-title">
              <span>Beard Rituals</span>
              <span class="tag">BARBER RITUAL</span>
            </div>
            <ul class="price-item-list">
              <li class="price-item">
                <div>
                  <span class="price-name">Beard Trim & Clean Shape</span>
                  <p class="form-help">Clipper contouring, neckline clean, and beard butter finish.</p>
                </div>
                <span class="price-amount">₹200</span>
              </li>
              <li class="price-item">
                <div>
                  <span class="price-name">Hot Towel Shave</span>
                  <p class="form-help">Eucalyptus hot steam towel, rich lather, single-blade razor, cold compress.</p>
                </div>
                <span class="price-amount">₹350</span>
              </li>
              <li class="price-item">
                <div>
                  <span class="price-name">Beard Colour & Grey Camouflage</span>
                  <p class="form-help">Natural ammonia-free tone matching to soften grey stubble.</p>
                </div>
                <span class="price-amount">₹300</span>
              </li>
              <li class="price-item">
                <div>
                  <span class="price-name">Moustache Styling</span>
                  <p class="form-help">Trimming, wax shaping, and upper lip definition.</p>
                </div>
                <span class="price-amount">₹150</span>
              </li>
            </ul>
          </div>
          <div class="service-card-action">
            <a href="/book?service=Hot+Towel+Shave" class="btn btn-gold" style="width:100%;">Book Beard Service</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== SECTION 3: HAIR & SCALP CARE ==================== -->
    <section class="content-section" id="scalp-care">
      <div class="section-header-block">
        <span class="section-kicker">DISCIPLINE 03</span>
        <h2 class="section-title">Hair & Scalp <span class="italic-serif">Restoration</span></h2>
        <p class="section-desc">Active targeted therapies addressing hair thinning, dandruff buildup, and urban stress.</p>
      </div>

      <div class="service-groups-grid">
        <div class="service-category-card">
          <div>
            <div class="card-cat-title">
              <span>Therapeutic Treatments</span>
              <span class="tag">WELLNESS</span>
            </div>
            <ul class="price-item-list">
              <li class="price-item">
                <div>
                  <span class="price-name">Hair Spa</span>
                  <p class="form-help">Deep condition cream mask, micro-steam cap, scalp circulation massage.</p>
                </div>
                <span class="price-amount">₹800</span>
              </li>
              <li class="price-item">
                <div>
                  <span class="price-name">Anti-Dandruff Treatment</span>
                  <p class="form-help">Salicylic scalp peel, tea tree antiseptic wash, calming tonic.</p>
                </div>
                <span class="price-amount">₹1000</span>
              </li>
              <li class="price-item">
                <div>
                  <span class="price-name">De-Tan Treatment</span>
                  <p class="form-help">Sun damage correction cream and antioxidant brightening compress.</p>
                </div>
                <span class="price-amount">₹700</span>
              </li>
              <li class="price-item">
                <div>
                  <span class="price-name">Therapeutic Head Massage (20m)</span>
                  <p class="form-help">Warm almond or mint oil acupressure tension release.</p>
                </div>
                <span class="price-amount">₹300</span>
              </li>
            </ul>
          </div>
          <div class="service-card-action">
            <a href="/book?service=Hair+Spa" class="btn btn-charcoal" style="width:100%;">Book Treatment</a>
          </div>
        </div>

        <!-- Groom Package Card -->
        <div class="service-category-card" style="border: 2px solid var(--color-gold);">
          <div>
            <div class="card-cat-title">
              <span>The Groom Package</span>
              <span class="tag" style="background:var(--color-gold); color:var(--color-charcoal-dark); padding:2px 8px;">ALL-INCLUSIVE</span>
            </div>
            <div style="margin-bottom: 16px;">
              <span style="font-family:var(--font-serif); font-size:42px; color:var(--color-gold);">₹3500</span>
              <span style="font-size:12px; font-style:italic; color:var(--color-grey-mid); display:block;">Full Wedding Grooming Protocol</span>
            </div>
            <ul class="price-item-list">
              <li class="price-item">
                <span class="price-name">Master Haircut & Skin Fade</span>
                <span style="color:var(--color-gold);">Included</span>
              </li>
              <li class="price-item">
                <span class="price-name">Beard Sculpture & Razor Lineup</span>
                <span style="color:var(--color-gold);">Included</span>
              </li>
              <li class="price-item">
                <span class="price-name">Glow Facial & De-Tan Mask</span>
                <span style="color:var(--color-gold);">Included</span>
              </li>
              <li class="price-item">
                <span class="price-name">Thermal Botanical Hair Spa</span>
                <span style="color:var(--color-gold);">Included</span>
              </li>
            </ul>
          </div>
          <div class="service-card-action">
            <a href="/book?service=Groom+Package" class="btn btn-gold" style="width:100%;">Book Groom Package</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== SECTION 4: WHAT TO EXPECT (3 STEPS) ==================== -->
    <section class="content-section" id="consultation-steps" style="background-color: var(--color-ivory-light);">
      <div class="section-header-block">
        <span class="section-kicker">THE FADE STUDIO EXPERIENCE</span>
        <h2 class="section-title">What to expect on your <span class="italic-serif">first visit.</span></h2>
        <p class="section-desc">We never rush the chair. Our disciplined 3-step service flow ensures you leave looking and feeling your absolute best.</p>
      </div>

      <div class="steps-grid">
        <div class="step-card">
          <span class="step-num">01</span>
          <h3 class="step-title">Consult</h3>
          <p class="step-desc">
            We inspect your crown growth patterns, hairline contours, and jaw angles. We discuss how you wear your hair and recommend a length and fade taper that works seamlessly.
          </p>
        </div>

        <div class="step-card">
          <span class="step-num">02</span>
          <h3 class="step-title">Cut</h3>
          <p class="step-desc">
            Crafted with precision sectioning, Japanese steel shear work, and cordless zero-gap clippers. We detail every millimeter, fading gradually from skin to weight.
          </p>
        </div>

        <div class="step-card">
          <span class="step-num">03</span>
          <h3 class="step-title">Finish</h3>
          <p class="step-desc">
            Straight-razor neck clean, refreshing tonic splash, blow-dry sculpting, and high-performance matte clay or sea salt spray. You leave sharp, clean, and styled.
          </p>
        </div>
      </div>
    </section>

    <!-- ==================== CALL TO ACTION STRIP ==================== -->
    <section class="booking-cta-strip">
      <div class="booking-cta-inner">
        <div class="cta-left">
          <span class="cta-kicker">READY TO SHARPEN UP?</span>
          <h2 class="cta-heading">Your barber chair is <span class="italic-serif">ready.</span></h2>
          <p class="cta-desc">Same-day appointments and weekend slots available. Book online in 60 seconds.</p>
        </div>
        <div>
          <a href="/book" class="btn btn-gold">Book Your Cut Now</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
