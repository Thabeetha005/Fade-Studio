---
import BaseLayout from '../layouts/BaseLayout.astro';
import { WHATSAPP_URL, PHONE_CALL_URL, PHONE_NUMBER, SALON_HOURS, SALON_ADDRESS } from '../config.js';
---

<BaseLayout
  title="Book an Appointment — FADE STUDIO | Direct WhatsApp Reservation"
  description="Book your haircut, beard trim, or styling session directly on WhatsApp with FADE STUDIO Bengaluru. Instant confirmation and zero advance deposit."
  currentPage="book"
  showPreloader={false}
>
  <main id="mainContent">
    <!-- ==================== PAGE HERO ==================== -->
    <section class="page-hero">
      <div class="page-hero-inner">
        <span class="page-kicker">DIRECT RESERVATION DESK</span>
        <h1 class="page-hero-title">
          Reserve your <span class="italic-serif">chair.</span>
        </h1>
        <p class="page-hero-desc">
          We have made reservations effortless. Message our salon concierge directly on WhatsApp or call our front desk for instant chair scheduling with your preferred master stylist.
        </p>
      </div>
    </section>

    <!-- ==================== SECTION 1: WHATSAPP BOOKING ACTION & HOURS ==================== -->
    <section class="content-section" id="booking-section">
      <div class="contact-layout">

        <!-- Booking Direct Action Card -->
        <div class="form-card" style="display:flex; flex-direction:column; justify-content:center; gap:28px;">
          <div>
            <span class="card-index" style="color:var(--color-gold); font-size:11px; letter-spacing:0.16em; font-family:var(--font-sans); font-weight:700;">INSTANT CHAIR CONFIRMATION</span>
            <h2 style="font-family:var(--font-serif); font-size:clamp(28px, 4vw, 42px); line-height:1.1; margin:8px 0 16px; color:var(--color-charcoal); font-weight:400;">
              Book Directly via <span class="italic-serif">WhatsApp</span>
            </h2>
            <p class="p-normal" style="font-size:13.5px; line-height:1.65; color:#444;">
              Chat with our studio concierge in real-time. Tell us your requested service, preferred date and time slot, or share hair reference photos. We confirm your seat in minutes.
            </p>
          </div>

          <!-- Buttons Group -->
          <div style="display:flex; flex-direction:column; gap:14px;">
            <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="btn btn-charcoal" style="width:100%; min-height:52px; font-size:13px; letter-spacing:0.12em; background-color:#1A1A1C; display:inline-flex; align-items:center; justify-content:center; gap:10px;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color:var(--color-gold);">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              <span>Book on WhatsApp</span>
            </a>

            <a href={PHONE_CALL_URL} class="btn btn-outline" style="width:100%; min-height:48px; font-size:12px; letter-spacing:0.1em; display:inline-flex; align-items:center; justify-content:center; gap:8px;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>Call Us: {PHONE_NUMBER}</span>
            </a>
          </div>

          <!-- Studio Hours Box -->
          <div style="background:var(--color-ivory-light); border:1px solid var(--color-border); padding:20px; margin-top:4px;">
            <span style="font-family:var(--font-sans); font-size:10.5px; font-weight:700; color:var(--color-gold); letter-spacing:0.14em; text-transform:uppercase; display:block; margin-bottom:8px;">STUDIO OPENING HOURS</span>
            <p style="font-size:12.5px; color:var(--color-charcoal); margin-bottom:4px; font-weight:600; font-family:var(--font-sans);">{SALON_HOURS.weekdays}</p>
            <p style="font-size:12.5px; color:var(--color-charcoal); margin-bottom:8px; font-weight:600; font-family:var(--font-sans);">{SALON_HOURS.weekends}</p>
            <p style="font-size:11.5px; font-style:italic; color:#777; margin:0;">Zero booking deposit required. Free cancellations up to 2 hours before your appointment.</p>
          </div>
        </div>

        <!-- Right Side: Booking Perks & Details -->
        <div class="contact-details-box">
          <div>
            <span class="contact-block-title">STUDIO LOCATION</span>
            <p class="contact-block-value" style="font-size:20px;">
              {SALON_ADDRESS}
            </p>
            <p style="font-size:12px; font-style:italic; color:#666; margin-top:4px;">
              Dedicated valet parking available for all clients.
            </p>
          </div>

          <div>
            <span class="contact-block-title">NEED ASSISTANCE?</span>
            <p class="contact-block-value">
              <a href={PHONE_CALL_URL} style="color:var(--color-charcoal);">{PHONE_NUMBER}</a>
            </p>
            <p style="font-size:12px; font-style:italic; color:#666; margin-top:4px;">
              Direct line to our front desk concierge for same-day walk-in availability.
            </p>
          </div>

          <div style="background:var(--color-ivory-light); border:1px solid var(--color-border); padding:24px;">
            <span style="font-family:var(--font-sans); font-size:10.5px; font-weight:700; color:var(--color-gold); letter-spacing:0.12em; text-transform:uppercase;">EVERY CHAIR SESSION INCLUDES</span>
            <ul style="list-style:none; display:flex; flex-direction:column; gap:10px; margin-top:12px; font-size:12px; font-style:italic;">
              <li>— Comprehensive anatomical head & face consultation</li>
              <li>— Clarifying botanical hair wash & rinse</li>
              <li>— Complimentary pour-over coffee or cold brew</li>
              <li>— Professional finish styling & product application</li>
            </ul>
          </div>
        </div>

      </div>
    </section>

    <!-- ==================== SECTION 2: HOW BOOKING WORKS (3 STEPS) ==================== -->
    <section class="content-section theme-dark" id="how-it-works">
      <div class="section-header-block">
        <span class="section-kicker">SEAMLESS RESERVATION</span>
        <h2 class="section-title">How booking <span class="italic-serif">works.</span></h2>
        <p class="section-desc">Three simple steps to secure your chair at FADE STUDIO without forms, passwords, or prepayments.</p>
      </div>

      <div class="steps-grid">
        <div class="step-card" style="background-color: var(--color-charcoal-card); border-color: var(--color-border-dark);">
          <span class="step-num">01</span>
          <h3 class="step-title" style="color:var(--color-ivory);">Connect on WhatsApp</h3>
          <p class="step-desc" style="color:#D5D2CB;">
            Tap "Book on WhatsApp" to open a pre-filled chat with our studio. Tell us your requested service and convenient time slot.
          </p>
        </div>

        <div class="step-card" style="background-color: var(--color-charcoal-card); border-color: var(--color-border-dark);">
          <span class="step-num">02</span>
          <h3 class="step-title" style="color:var(--color-ivory);">Instant Confirmation</h3>
          <p class="step-desc" style="color:#D5D2CB;">
            Our front desk concierge verifies chair availability, assigns your preferred master stylist, and sends instant calendar confirmation.
          </p>
        </div>

        <div class="step-card" style="background-color: var(--color-charcoal-card); border-color: var(--color-border-dark);">
          <span class="step-num">03</span>
          <h3 class="step-title" style="color:var(--color-ivory);">Take Your Seat</h3>
          <p class="step-desc" style="color:#D5D2CB;">
            Arrive at our Indiranagar studio, enjoy a complimentary pour-over coffee, and experience unhurried precision grooming.
          </p>
        </div>
      </div>
    </section>

    <!-- ==================== SECTION 3: STUDIO ETIQUETTE ==================== -->
    <section class="content-section" id="etiquette">
      <div class="section-header-block">
        <span class="section-kicker">GUEST CONCIERGE</span>
        <h2 class="section-title">Studio <span class="italic-serif">Etiquette.</span></h2>
        <p class="section-desc">To preserve a peaceful, unhurried atmosphere for all guests, please keep the following guidelines in mind.</p>
      </div>

      <div class="steps-grid">
        <div class="step-card">
          <span class="step-num">01</span>
          <h3 class="step-title">Arrival Time</h3>
          <p class="step-desc">
            Please arrive 5 to 10 minutes prior to your booking. Relax in our waiting lounge with our curated print archives and espresso bar.
          </p>
        </div>

        <div class="step-card">
          <span class="step-num">02</span>
          <h3 class="step-title">Rescheduling</h3>
          <p class="step-desc">
            Plans change. If you must adjust your reservation, simply WhatsApp or call our desk at least 2 hours in advance so another guest may claim the chair.
          </p>
        </div>

        <div class="step-card">
          <span class="step-num">03</span>
          <h3 class="step-title">Calm Environment</h3>
          <p class="step-desc">
            We maintain an acoustic environment with soft ambient audio. We kindly ask guests to keep mobile calls brief and silent on speaker.
          </p>
        </div>
      </div>
    </section>

    <!-- ==================== SECTION 4: PRIVILEGE / OFFER BANNER ==================== -->
    <section class="offer-banner-section" id="offer">
      <div class="offer-hero-banner" style="background-image: url('/assets/image-17.jpg');">
        <div class="offer-scrim" aria-hidden="true"></div>

        <div class="offer-inner-content">
          <div class="offer-top">
            <span class="offer-kicker">FIRST VISIT PRIVILEGE</span>
            <h2 class="offer-heading">
              Get 15% off your <span class="italic-serif">first visit.</span>
            </h2>
          </div>

          <div class="offer-bottom">
            <div class="offer-text-col">
              <p class="offer-copy">
                Message us on WhatsApp mentioning code <strong>FIRSTFADE15</strong> to claim an instant 15% discount on all haircuts, beard treatments, and hair spas.
              </p>
            </div>

            <div class="offer-form-col">
              <div class="offer-input-group">
                <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="btn btn-gold" style="width:100%; display:inline-flex; align-items:center; justify-content:center; gap:8px;">
                  Claim 15% on WhatsApp &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
