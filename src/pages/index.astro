---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="FADE STUDIO — Unisex Grooming & Hair Studio | Cut Clean. Look Sharp."
  description="A modern grooming and hair studio for men and women. Precision skin fades, beard sculpting, hair treatments, and women"
  currentPage="home"
  showPreloader={true}
>
  <main id="mainContent">

    <!-- ==================== HERO SECTION ==================== -->
    <section class="hero-section" id="hero">
      <div class="hero-layout">


        <!-- Center Content: Headline & Intro -->
        <div class="hero-center-content">
          <div class="hero-headlines">
            <h1 class="hero-main-title">
              <span class="line line-1"><span class="reveal-inner">Fade into <span class="italic-serif">confidence.</span></span></span>
              <span class="line line-2">
                <span class="reveal-inner line-2-wrapper">
                  <span class="hero-meta-badge">
                    <span class="meta-label">Unisex Grooming & Hair Studio</span>
                    <span class="meta-num">01 / 25</span>
                  </span>
                  <span class="italic-serif italic-shifted">Cut clean. Look sharp.</span>
                </span>
              </span>
            </h1>
          </div>

          <div class="hero-copy-group">
            <div class="hero-italic-copy">
              <p>A modern grooming and hair studio for men and women.</p>
              <p>We listen first, then give you a look that fits your face, your style and your day.</p>
            </div>
            <div class="hero-body-copy">
              <p>From razor-sharp skin fades to nourishing botanical hair spas and elevated women’s colour treatments, our chairs are dedicated to intentional craftsmanship and genuine comfort.</p>
            </div>
          </div>

          <div class="hero-cta-group">
            <a href="/book" class="btn btn-charcoal">Book an Appointment</a>
            <a href="/services" class="btn btn-outline">View Services</a>
          </div>
        </div>

      </div>

      <!-- Under Hero Gallery -->
      <div class="hero-editorial-gallery">
        <div class="hero-cover-wrapper parallax-container">
          <div class="cover-image-container">
            <img src="/assets/hero-portrait.png" alt="Signature modern styling and skin fade by FADE STUDIO" class="cover-photo parallax-image" data-speed="0.08">
            <div class="cover-masthead-overlay" aria-hidden="true">
              <span class="cover-masthead-title">FADE STUDIO</span>
            </div>
            <div class="cover-bottom-caption">
              <span class="issue-sub">PRECISION CUTS · BEARD ARCHITECTURE · SKIN CARE</span>
            </div>
          </div>
        </div>

        <div class="hero-narrow-trio">
          <div class="narrow-item item-1 parallax-container">
            <div class="narrow-image-wrapper">
              <img src="/assets/men-1.jpg" alt="The Precision Skin Fade" class="narrow-photo parallax-image" data-speed="0.12">
            </div>
            <span class="narrow-caption">01 &mdash; Skin Fade Archive</span>
          </div>

          <div class="narrow-item item-2 parallax-container">
            <div class="narrow-image-wrapper">
              <img src="/assets/image-4.jpg" alt="Modern women's styling with sunglasses" class="narrow-photo parallax-image" data-speed="0.06">
            </div>
            <span class="narrow-caption">02 &mdash; Women's Studio</span>
          </div>

          <div class="narrow-item item-3 parallax-container">
            <div class="narrow-image-wrapper">
              <img src="/assets/men-3.jpg" alt="Beard Sculpt & Lineup" class="narrow-photo parallax-image" data-speed="0.14">
            </div>
            <span class="narrow-caption">03 &mdash; Beard Architecture</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== SIGNATURE SERVICES (HORIZONTAL PINNED SCROLL) ==================== -->
    <section class="featured-section" id="featured">
      <div class="featured-header-row">
        <div class="featured-title-col">
          <h2 class="featured-heading">
            Signature <span class="italic-serif">Services</span> <span class="text-grey">Catalogue</span>
          </h2>
        </div>
        <div class="featured-meta-col" aria-label="Studio Details">
          <span class="meta-item">Grooming</span>
          <span class="meta-dot">·</span>
          <span class="meta-item">Men 70%</span>
          <span class="meta-dot">·</span>
          <span class="meta-item">Women 30%</span>
          <span class="meta-dot">·</span>
          <span class="meta-item">Est. 2024</span>
        </div>
      </div>

      <div class="featured-content-wrapper" id="featuredPinWrapper">
        <div class="featured-left-editorial">
          <div class="editorial-quote-box">
            <div class="vertical-line" aria-hidden="true"></div>
            <div class="editorial-text-group">
              <p class="quote-p">Every chair session at FADE STUDIO begins with consultation, precision sectioning, and finish styling with imported clays and tonics.</p>
              <p class="quote-p">Crafted for those who value calm, sharp detail and uncompromising grooming standards.</p>
            </div>
          </div>
          <div class="editorial-cta">
            <a href="/services" class="btn btn-outline">View All Services</a>
          </div>
        </div>

        <div class="featured-cards-track-container" id="featuredCardsContainer">
          <div class="featured-cards-track" id="featuredCardsTrack">
            <!-- Card 1 -->
            <article class="featured-card">
              <div class="card-image-box">
                <img src="/assets/men-1.jpg" alt="The Precision Fade at FADE STUDIO" class="card-img">
                <div class="card-scrim" aria-hidden="true"></div>
                <div class="card-text-overlay">
                  <span class="card-index">SERVICE 01 · ₹400</span>
                  <h3 class="card-title">The Precision Fade</h3>
                  <p class="card-desc">Clean skin fades, taper fades and razor-sharp line finishes tailored to skull contours.</p>
                  <a href="/book?service=Skin+Fade" class="card-read-hint">BOOK SERVICE &rarr;</a>
                </div>
              </div>
            </article>

            <!-- Card 2 -->
            <article class="featured-card">
              <div class="card-image-box">
                <img src="/assets/men-5.jpg" alt="Beard and Hot Towel Shave" class="card-img">
                <div class="card-scrim" aria-hidden="true"></div>
                <div class="card-text-overlay">
                  <span class="card-index">SERVICE 02 · ₹350</span>
                  <h3 class="card-title">Beard & Hot Towel Shave</h3>
                  <p class="card-desc">Shaping, trimming, essential oil hot towel compress, and a calm, close straight-edge shave.</p>
                  <a href="/book?service=Hot+Towel+Shave" class="card-read-hint">BOOK SERVICE &rarr;</a>
                </div>
              </div>
            </article>

            <!-- Card 3 -->
            <article class="featured-card">
              <div class="card-image-box">
                <img src="/assets/image-6.jpg" alt="Colour and Gloss Hair Studio" class="card-img">
                <div class="card-scrim" aria-hidden="true"></div>
                <div class="card-text-overlay">
                  <span class="card-index">SERVICE 03 · ₹1200</span>
                  <h3 class="card-title">Colour & Gloss</h3>
                  <p class="card-desc">Natural ammonia-free colour, grey blending, tonal highlights, and shine revitalizing gloss.</p>
                  <a href="/book?service=Global+Colour" class="card-read-hint">BOOK SERVICE &rarr;</a>
                </div>
              </div>
            </article>

            <!-- Card 4 -->
            <article class="featured-card">
              <div class="card-image-box">
                <img src="/assets/men-6.jpg" alt="Hair Spa and Scalp Care" class="card-img">
                <div class="card-scrim" aria-hidden="true"></div>
                <div class="card-text-overlay">
                  <span class="card-index">SERVICE 04 · ₹800</span>
                  <h3 class="card-title">Hair Spa & Scalp Care</h3>
                  <p class="card-desc">Deep detox for dandruff, dryness, scalp stimulation, and thermal micro-mist infusion.</p>
                  <a href="/book?service=Hair+Spa" class="card-read-hint">BOOK SERVICE &rarr;</a>
                </div>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== STATEMENT SECTION ==================== -->
    <section class="statement-section" id="statement">
      <div class="statement-container">
        <div class="statement-left">
          <div class="statement-label-wrap">
            <span class="statement-label">Our Philosophy</span>
          </div>

          <h2 class="statement-heading">
            Style is how you <span class="italic-serif">feel.</span>
          </h2>

          <div class="statement-paragraphs">
            <p class="statement-lead">
              We listen first, study your natural hair flow and bone structure, and then craft a cut that holds its shape for weeks — not just for the day you leave the chair.
            </p>
            <p>
              We shape modern trends around the individual person, not the other way around. Whether it's an understated corporate taper or a statement bridal balayage, the result is effortless, confident elegance.
            </p>
            <p>
              Step inside, enjoy a freshly brewed pour-over coffee, and let our specialists elevate your daily grooming routine.
            </p>
          </div>

          <div style="margin-top: 36px;">
            <a href="/about" class="btn btn-outline">Read Our Story</a>
          </div>
        </div>

        <div class="statement-right">
          <div class="statement-photo-duo">
            <div class="statement-photo-item photo-high parallax-container">
              <img src="/assets/image-9.jpg" alt="Relaxed client styling at FADE STUDIO" class="statement-img parallax-image" data-speed="0.08">
              <span class="photo-subtext">FIGURE I &mdash; THE CALM CONSULTATION</span>
            </div>
            <div class="statement-photo-item photo-low parallax-container">
              <img src="/assets/image-10.jpg" alt="Tailored hair finish at FADE STUDIO" class="statement-img parallax-image" data-speed="0.14">
              <span class="photo-subtext">FIGURE II &mdash; SHARP SILHOUETTE</span>
            </div>
          </div>
          <div class="statement-footnote-line">
            <div class="footnote-hairline" aria-hidden="true"></div>
            <p class="footnote-text">Welcome to the new standard of grooming</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== LOOKS FOR EVERY MOMENT ==================== -->
    <section class="moments-section" id="moments">
      <div class="moments-header">
        <span class="moments-sublabel">CURATED OCCASIONS</span>
        <span class="moments-sublabel" style="color:var(--color-charcoal);">LOOKS FOR EVERY MOMENT</span>
      </div>

      <div class="moments-columns-grid">
        <!-- Moment 1: Everyday Sharp -->
        <article class="moment-column moment-col-1">
          <div class="moment-image-wrapper">
            <img src="/assets/men-4.jpg" alt="Everyday Sharp styling for work and weekends" class="moment-photo">
            <div class="moment-overlay-title">
              <h3 class="moment-title">Everyday Sharp</h3>
            </div>
          </div>
          <p class="moment-desc">
            Quick, clean styling, neckline cleans, and beard maintenance for workdays and effortless weekends.
          </p>
          <a href="/men" class="btn btn-outline" style="align-self: flex-start; margin-top: 4px;">Men's Grooming</a>
        </article>

        <!-- Moment 2: Groom Ready -->
        <article class="moment-column moment-col-2">
          <div class="moment-image-wrapper">
            <img src="/assets/men-2.jpg" alt="Groom Ready wedding grooming packages" class="moment-photo">
            <div class="moment-overlay-title">
              <h3 class="moment-title">Groom Ready</h3>
            </div>
          </div>
          <p class="moment-desc">
            Full wedding grooming packages including facial de-tan, haircut, beard ritual, and thermal scalp therapy.
          </p>
          <a href="/pricing#packages" class="btn btn-outline" style="align-self: flex-start; margin-top: 4px;">Groom Packages</a>
        </article>

        <!-- Moment 3: Women & Bridal -->
        <article class="moment-column moment-col-3">
          <div class="moment-image-wrapper">
            <img src="/assets/image-7.jpg" alt="Women and Bridal hair and makeup services" class="moment-photo">
            <div class="moment-overlay-title">
              <h3 class="moment-title">Women & Bridal</h3>
            </div>
          </div>
          <p class="moment-desc">
            Designer cuts, multidimensional colour, bouncy blow-dries, and timeless bridal hair & makeup.
          </p>
          <a href="/women" class="btn btn-outline" style="align-self: flex-start; margin-top: 4px;">Women's Salon</a>
        </article>
      </div>

      <div class="moments-footer-heading">
        <h2 class="shaping-heading">
          Grooming radar: What's <span class="italic-serif">defining your style</span>
        </h2>
      </div>
    </section>

    <!-- ==================== MEET THE TEAM ==================== -->
    <section class="team-preview-section" id="team">
      <div class="team-container">
        <!-- Left: Team intro -->
        <div class="team-left">
          <span class="team-kicker">MASTER CRAFTSMEN</span>
          <h2 class="team-heading">
            Meet the <span class="italic-serif">Team</span>
          </h2>
          <div class="team-intro-text">
            <p>Our barbers and hair artists bring decades of collective studio experience from London, Mumbai, and Bengaluru.</p>
            <p>We blend classic scissor-over-comb discipline with progressive barbering techniques to deliver consistent precision every visit.</p>
          </div>
          <div class="team-cta">
            <a href="/about" class="btn btn-outline">Explore Full Story & Team</a>
          </div>
        </div>

        <!-- Right: Team list -->
        <div class="team-articles-list">
          <!-- Member 1 -->
          <article class="team-member-item">
            <div class="team-thumb-box">
              <img src="/assets/team-1.jpg" alt="Vikram Malhotra - Master Barber" class="team-thumb">
            </div>
            <div class="team-info">
              <span class="team-meta">FOUNDER · 12 YEARS EXPERIENCE</span>
              <h3 class="team-name">Vikram Malhotra</h3>
              <p class="team-bio">Specialist in anatomical head mapping, zero skin fades, and traditional straight razor shaves.</p>
            </div>
            <a href="/about#team" class="btn btn-charcoal">Profile</a>
          </article>

          <!-- Member 2 -->
          <article class="team-member-item">
            <div class="team-thumb-box">
              <img src="/assets/team-2.jpg" alt="Arjun Nair - Senior Fade Specialist" class="team-thumb">
            </div>
            <div class="team-info">
              <span class="team-meta">SENIOR BARBER · 08 YEARS EXPERIENCE</span>
              <h3 class="team-name">Arjun Nair</h3>
              <p class="team-bio">Master of tapers, beard sculpture, line-ups, and contemporary textured crops.</p>
            </div>
            <a href="/about#team" class="btn btn-charcoal">Profile</a>
          </article>

          <!-- Member 3 -->
          <article class="team-member-item">
            <div class="team-thumb-box">
              <img src="/assets/team-3.jpg" alt="Priya Sharma - Creative Director" class="team-thumb">
            </div>
            <div class="team-info">
              <span class="team-meta">CREATIVE DIRECTOR · 10 YEARS EXPERIENCE</span>
              <h3 class="team-name">Priya Sharma</h3>
              <p class="team-bio">Specializing in women's precision bobs, soft layers, balayage, and luxury bridal styling.</p>
            </div>
            <a href="/about#team" class="btn btn-charcoal">Profile</a>
          </article>
        </div>
      </div>
    </section>

    <!-- ==================== OFFER BANNER ==================== -->
    <section class="offer-banner-section" id="offer">
      <div class="offer-hero-banner" style="background-image: url('/assets/image-17.jpg');">
        <div class="offer-scrim" aria-hidden="true"></div>

        <div class="offer-inner-content">
          <div class="offer-top">
            <span class="offer-kicker">FIRST VISIT PRIVILEGE</span>
            <h2 class="offer-heading">
              Get 15% off your <span class="italic-serif">first visit.</span>
            </h2>
          </div>

          <div class="offer-bottom">
            <div class="offer-text-col">
              <p class="offer-copy">
                Join our private guestbook to receive an instant 15% voucher on all haircuts, beard treatments, and hair spas, alongside exclusive seasonal studio updates.
              </p>
            </div>

            <div class="offer-form-col">
              <form class="fade-offer-form" id="homeOfferForm">
                <div class="offer-input-group">
                  <label for="homeOfferEmail" class="sr-only">Your email address</label>
                  <input type="email" id="homeOfferEmail" placeholder="Enter your email address" required class="offer-input">
                  <button type="submit" class="btn btn-gold">Claim Offer</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
