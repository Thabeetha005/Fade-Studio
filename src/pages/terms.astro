---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Terms of Use — FADE STUDIO | Booking & Salon Terms"
  description="Read the official Terms of Use for FADE STUDIO. Information regarding chair appointments, cancellations, payments, and client satisfaction policies."
  currentPage="terms"
  showPreloader={false}
>
  <main id="mainContent">

    <!-- ==================== HERO ==================== -->
    <section class="page-hero">
      <div class="page-hero-inner">
        <span class="page-kicker">TERMS & AGREEMENTS</span>
        <h1 class="page-hero-title">
          Terms of <span class="italic-serif">Use.</span>
        </h1>
        <p class="page-hero-desc">
          These terms govern your appointments, studio visits, and interaction with FADE STUDIO services. Clear rules ensure a seamless, respectful experience for every client and artisan.
        </p>
      </div>
    </section>

    <!-- ==================== SECTION 1: THE FULL TERMS (6+ SECTIONS) ==================== -->
    <section class="content-section" id="terms-content">
      <div class="legal-container">

        <article class="legal-section-item">
          <h2 class="legal-section-title">01. Appointment Booking & Punctuality</h2>
          <p>
            Appointments may be requested online through our booking engine or by contacting our front desk concierge directly. Because we allocate dedicated, unhurried time blocks for every haircut, shave, and facial, we ask that you arrive 5 to 10 minutes prior to your scheduled hour.
          </p>
          <p>
            If you anticipate a delay exceeding 15 minutes, please alert our front desk as soon as possible. Depending on subsequent stylist bookings, late arrivals may require a modified service scope to avoid delaying the next guest.
          </p>
        </article>

        <article class="legal-section-item">
          <h2 class="legal-section-title">02. Cancellations & Rescheduling</h2>
          <p>
            We understand unforeseen schedule changes occur. We do not charge cancellation fees, but we kindly request at least two (2) hours of advance notice for cancellations or date shifts so that waitlisted guests may be accommodated.
          </p>
          <p>
            Repeated missed appointments without prior notice may necessitate upfront deposits for future reservations.
          </p>
        </article>

        <article class="legal-section-item">
          <h2 class="legal-section-title">03. Pricing & Payment Policy</h2>
          <p>
            All prices published on our pricing page and printed menu are in Indian Rupees (INR) and are inclusive of standard consultation, hair wash, and finish product application. We do not impose surprise convenience surcharges.
          </p>
          <p>
            Payment is due immediately upon the conclusion of your chair session. We accept all major Credit/Debit Cards, UPI (Google Pay, PhonePe, Paytm), and Cash.
          </p>
        </article>

        <article class="legal-section-item">
          <h2 class="legal-section-title">04. Service Satisfaction Guarantee</h2>
          <p>
            Your complete confidence is our benchmark. If you feel your haircut taper, beard shape, or hair colour requires fine-tuning, please inform us within five (5) days of your initial visit.
          </p>
          <p>
            We will gladly schedule a complimentary adjustment session with your stylist or a senior artist to make sure you love your final look.
          </p>
        </article>

        <article class="legal-section-item">
          <h2 class="legal-section-title">05. Studio Hygiene & Health Conduct</h2>
          <p>
            FADE STUDIO operates under strict clinical hygiene standards. If you are experiencing symptoms of an infectious skin condition, cold, or flu, we kindly ask that you reschedule your session until fully recovered.
          </p>
          <p>
            Our artisans reserve the right to decline service if continuing presents a health risk to the guest or the studio environment.
          </p>
        </article>

        <article class="legal-section-item">
          <h2 class="legal-section-title">06. Liability & Jurisdiction</h2>
          <p>
            Clients must disclose any relevant scalp conditions, chemical sensitivities, or allergies prior to receiving chemical treatments or facials. FADE STUDIO cannot be held liable for undisclosed pre-existing conditions.
          </p>
          <p>
            These terms of use shall be governed by and construed in accordance with the laws of India, and any disputes arising shall be subject exclusively to the courts of Bengaluru, Karnataka.
          </p>
        </article>

      </div>
    </section>

    <!-- ==================== SECTION 2: CLIENT GUARANTEE ==================== -->
    <section class="content-section theme-dark" id="terms-guarantee">
      <div class="section-header-block">
        <span class="section-kicker">OUR PROMISE</span>
        <h2 class="section-title">The FADE STUDIO <span class="italic-serif">Code.</span></h2>
        <p class="section-desc">Our commitment to transparency, professional courtesy, and artisanal integrity.</p>
      </div>

      <div class="steps-grid">
        <div class="step-card" style="background-color: var(--color-charcoal-card); border-color: var(--color-border-dark);">
          <span class="step-num">01</span>
          <h3 class="step-title" style="color:var(--color-ivory);">Honest Rates</h3>
          <p class="step-desc" style="color:#D5D2CB;">The price on the menu is the exact price you pay. No forced retail pushes or unnecessary add-ons.</p>
        </div>
        <div class="step-card" style="background-color: var(--color-charcoal-card); border-color: var(--color-border-dark);">
          <span class="step-num">02</span>
          <h3 class="step-title" style="color:var(--color-ivory);">Punctual Chairs</h3>
          <p class="step-desc" style="color:#D5D2CB;">We respect your time. Booked slots receive immediate seat priority over walk-in guests.</p>
        </div>
        <div class="step-card" style="background-color: var(--color-charcoal-card); border-color: var(--color-border-dark);">
          <span class="step-num">03</span>
          <h3 class="step-title" style="color:var(--color-ivory);">5-Day Tuning</h3>
          <p class="step-desc" style="color:#D5D2CB;">Need a slight trim adjustment after living with your new cut? Drop back in within 5 days on us.</p>
        </div>
      </div>
    </section>

    <!-- ==================== SECTION 3: CALL TO ACTION ==================== -->
    <section class="booking-cta-strip">
      <div class="booking-cta-inner">
        <div class="cta-left">
          <span class="cta-kicker">CHAIR RESERVATION</span>
          <h2 class="cta-heading">Ready for a <span class="italic-serif">sharper cut?</span></h2>
          <p class="cta-desc">Experience grooming as it was meant to be. Simple, calm, and tailored.</p>
        </div>
        <div>
          <a href="/book" class="btn btn-gold">Book Your Appointment</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
