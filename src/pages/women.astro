---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Women's Hair & Beauty — FADE STUDIO | Cuts, Colour, & Bridal Styling"
  description="Dedicated women"
  currentPage="women"
  showPreloader={false}
>
  <main id="mainContent">

    <!-- ==================== HERO ==================== -->
    <section class="page-hero">
      <div class="page-hero-inner">
        <span class="page-kicker">WOMEN'S SALON & COUTURE</span>
        <h1 class="page-hero-title">
          Hair & beauty, <span class="italic-serif">made simple.</span>
        </h1>
        <p class="page-hero-desc">
          Thoughtful, customized styling without the fuss. From effortless curtain bangs and fluid layers to deep multidimensional balayage and radiant bridal makeup, our artists celebrate your natural texture.
        </p>
        <div class="page-hero-cta">
          <a href="/book" class="btn btn-charcoal">Book a Women's Session</a>
          <a href="#bridal-events" class="btn btn-outline">Explore Bridal Packages</a>
        </div>
      </div>
    </section>

    <!-- ==================== SECTION 1: CUTS & STYLING ==================== -->
    <section class="content-section" id="cuts-styling">
      <div class="section-header-block">
        <span class="section-kicker">SECTION 01</span>
        <h2 class="section-title">Designer Haircuts & <span class="italic-serif">Blow-Outs</span></h2>
        <p class="section-desc">Cuts designed to fall into place effortlessly at home, with minimal morning styling required.</p>
      </div>

      <div class="service-groups-grid">
        <div class="service-category-card">
          <div>
            <div class="card-cat-title">
              <span>Cuts & Styling</span>
              <span class="tag">STUDIO</span>
            </div>
            <ul class="price-item-list">
              <li class="price-item">
                <div>
                  <span class="price-name">Women's Designer Haircut</span>
                  <p class="form-help">Custom consultation, hair wash, scalp massage, precision cut, and blow-dry finish.</p>
                </div>
                <span class="price-amount">₹600</span>
              </li>
              <li class="price-item">
                <div>
                  <span class="price-name">Signature Bouncy Blow-Dry</span>
                  <p class="form-help">Round brush volume, smooth waves or straight finish using thermal protectants.</p>
                </div>
                <span class="price-amount">₹500</span>
              </li>
              <li class="price-item">
                <div>
                  <span class="price-name">Fringe & Bang Reshape</span>
                  <p class="form-help">Curtain bang refinement, face framing, or micro-bang detailing.</p>
                </div>
                <span class="price-amount">₹250</span>
              </li>
              <li class="price-item">
                <div>
                  <span class="price-name">Clarifying Wash & Hydration Mask</span>
                  <p class="form-help">Sulfate-free scalp shampoo and deep nourishing cuticle conditioner.</p>
                </div>
                <span class="price-amount">₹350</span>
              </li>
            </ul>
          </div>
          <div class="service-card-action">
            <a href="/book?service=Women's+Haircut" class="btn btn-charcoal" style="width:100%;">Book a Haircut</a>
          </div>
        </div>

        <div class="service-category-card" style="padding:0; overflow:hidden;">
          <img loading="lazy" decoding="async" src="/assets/image-16.jpg" alt="Sharp geometric haircut for women" style="width:100%; height:100%; object-fit:cover;">
        </div>
      </div>
    </section>

    <!-- ==================== SECTION 2: COLOUR & BALAYAGE (DARK THEME) ==================== -->
    <section class="content-section theme-dark" id="colour">
      <div class="section-header-block">
        <span class="section-kicker">SECTION 02</span>
        <h2 class="section-title">Multidimensional <span class="italic-serif">Colour & Gloss</span></h2>
        <p class="section-desc">Low-maintenance, sun-kissed tones and healthy ammonia-free pigments that protect your hair shaft.</p>
      </div>

      <div class="service-groups-grid">
        <div class="service-category-card" style="padding:0; overflow:hidden;">
          <img loading="lazy" decoding="async" src="/assets/image-3.jpg" alt="Golden warm tones hair color at FADE STUDIO" style="width:100%; height:100%; object-fit:cover;">
        </div>

        <div class="service-category-card">
          <div>
            <div class="card-cat-title">
              <span>Colour Services</span>
              <span class="tag">ARTISTRY</span>
            </div>
            <ul class="price-item-list">
              <li class="price-item">
                <div>
                  <span class="price-name">Women's Global Colour</span>
                  <p class="form-help">Rich uniform shade, 100% grey coverage, and deep gloss seal.</p>
                </div>
                <span class="price-amount">₹2000</span>
              </li>
              <li class="price-item">
                <div>
                  <span class="price-name">Root Touch-Up</span>
                  <p class="form-help">Regrowth coverage up to 2 inches with seamless tone matching.</p>
                </div>
                <span class="price-amount">₹900</span>
              </li>
              <li class="price-item">
                <div>
                  <span class="price-name">Balayage & Foilyage Highlights</span>
                  <p class="form-help">Hand-painted dimension for natural graduation and soft regrowth lines.</p>
                </div>
                <span class="price-amount">₹3500</span>
              </li>
              <li class="price-item">
                <div>
                  <span class="price-name">Tonal Glaze & Shine Treatment</span>
                  <p class="form-help">Revives dull brassiness and deposits luminous translucent shine.</p>
                </div>
                <span class="price-amount">₹1200</span>
              </li>
            </ul>
          </div>
          <div class="service-card-action">
            <a href="/book?service=Global+Colour" class="btn btn-gold" style="width:100%;">Book Colour Consultation</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== SECTION 3: SKIN & FACIAL ==================== -->
    <section class="content-section" id="skin-facial">
      <div class="section-header-block">
        <span class="section-kicker">SECTION 03</span>
        <h2 class="section-title">Skin Minimalism & <span class="italic-serif">Facial Glow</span></h2>
        <p class="section-desc">Facial rituals crafted for instant hydration, lymphatic drainage, and luminous dewy skin.</p>
      </div>

      <div class="service-groups-grid">
        <div class="service-category-card">
          <div>
            <div class="card-cat-title">
              <span>Facial Therapies</span>
              <span class="tag">SKIN HEALTH</span>
            </div>
            <ul class="price-item-list">
              <li class="price-item">
                <div>
                  <span class="price-name">Luxury Hydrating Facial</span>
                  <p class="form-help">Hyaluronic moisture infusion, steam extraction, and cool jade stone massage.</p>
                </div>
                <span class="price-amount">₹1500</span>
              </li>
              <li class="price-item">
                <div>
                  <span class="price-name">Glow Clean-Up</span>
                  <p class="form-help">Gentle enzymatic exfoliation, pore cleansing, and botanical vitamin C mask.</p>
                </div>
                <span class="price-amount">₹800</span>
              </li>
              <li class="price-item">
                <div>
                  <span class="price-name">De-Tan Therapy</span>
                  <p class="form-help">Skin brightening protocol targeting uneven tone from sun exposure.</p>
                </div>
                <span class="price-amount">₹900</span>
              </li>
            </ul>
          </div>
          <div class="service-card-action">
            <a href="/book?service=Glow+Facial" class="btn btn-charcoal" style="width:100%;">Book Facial</a>
          </div>
        </div>

        <div class="service-category-card" style="padding:0; overflow:hidden;">
          <img loading="lazy" decoding="async" src="/assets/image-14.jpg" alt="Natural glowing skin close up at FADE STUDIO" style="width:100%; height:100%; object-fit:cover;">
        </div>
      </div>
    </section>

    <!-- ==================== SECTION 4: BRIDAL & EVENTS ==================== -->
    <section class="content-section" id="bridal-events" style="background-color: var(--color-ivory-light);">
      <div class="section-header-block">
        <span class="section-kicker">SECTION 04</span>
        <h2 class="section-title">Bridal & <span class="italic-serif">Event Architecture</span></h2>
        <p class="section-desc">Timeless, elegant aesthetics for your most cherished celebrations. Available in-studio or on location.</p>
      </div>

      <div class="service-groups-grid">
        <div class="service-category-card" style="padding:0; overflow:hidden;">
          <img loading="lazy" decoding="async" src="/assets/image-7.jpg" alt="Bridal elegance and dress styling at FADE STUDIO" style="width:100%; height:100%; object-fit:cover;">
        </div>

        <div class="service-category-card" style="border: 2px solid var(--color-gold);">
          <div>
            <div class="card-cat-title">
              <span>Bridal Packages</span>
              <span class="tag" style="background:var(--color-gold); color:var(--color-charcoal-dark); padding:2px 8px;">SIGNATURE</span>
            </div>
            <ul class="price-item-list">
              <li class="price-item">
                <div>
                  <span class="price-name">Complete Bridal Hair & Makeup</span>
                  <p class="form-help">HD bridal makeup, hair updo or waves, lash application, saree/dupatta draping.</p>
                </div>
                <span class="price-amount">from ₹8000</span>
              </li>
              <li class="price-item">
                <div>
                  <span class="price-name">Sangeet & Cocktail Styling</span>
                  <p class="form-help">Modern textured hair, glamorous eye makeup, and setting spray.</p>
                </div>
                <span class="price-amount">₹4500</span>
              </li>
              <li class="price-item">
                <div>
                  <span class="price-name">Event Hair Updo & Draping</span>
                  <p class="form-help">Intricate braiding or sleek chignon paired with precision dupatta pinning.</p>
                </div>
                <span class="price-amount">₹2500</span>
              </li>
              <li class="price-item">
                <div>
                  <span class="price-name">Pre-Bridal Glow Package</span>
                  <p class="form-help">Custom multi-session skin clean-up, hair spa, and scalp revival.</p>
                </div>
                <span class="price-amount">On Request</span>
              </li>
            </ul>
          </div>
          <div class="service-card-action">
            <a href="/contact?inquiry=bridal" class="btn btn-gold" style="width:100%;">Inquire Bridal Date</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== CALL TO ACTION STRIP ==================== -->
    <section class="booking-cta-strip">
      <div class="cta-left">
        <span class="cta-kicker">CUSTOM CONSULTATION</span>
        <h2 class="cta-heading">Elevate your hair <span class="italic-serif">ritual.</span></h2>
        <p class="cta-desc">Discuss your style with our Creative Director Priya Sharma and enjoy an unhurried, serene salon experience.</p>
      </div>
      <div>
        <a href="/book" class="btn btn-gold">Reserve Your Session</a>
      </div>
    </section>
  </main>
</BaseLayout>
