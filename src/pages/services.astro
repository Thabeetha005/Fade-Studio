---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Services Menu — FADE STUDIO | Unisex Grooming & Hair Studio"
  description="Explore FADE STUDIO"
  currentPage="services"
  showPreloader={false}
>
  <main id="mainContent">

    <!-- ==================== PAGE HERO ==================== -->
    <section class="page-hero">
      <div class="page-hero-inner">
        <span class="page-kicker">SERVICES CATALOGUE</span>
        <h1 class="page-hero-title">
          Tailored craft for <span class="italic-serif">hair, beard & skin.</span>
        </h1>
        <p class="page-hero-desc">
          Every service is performed with surgical attention to detail, premium botanical formulations, and custom consultation to ensure your style looks natural and stays sharp.
        </p>
        <div class="page-hero-cta">
          <a href="/book" class="btn btn-charcoal">Book an Appointment</a>
          <a href="/pricing" class="btn btn-outline">View Full Price List</a>
        </div>
      </div>
    </section>

    <!-- ==================== SECTION 1: MEN'S HAIR & BEARD ==================== -->
    <section class="services-catalog-section" id="mens-services">
      <div class="section-header-block">
        <span class="section-kicker">MEN'S SIGNATURE GROOMING</span>
        <h2 class="section-title">Precision Barbering & <span class="italic-serif">Beard Architecture</span></h2>
        <p class="section-desc">Our flagship services combining traditional straight-razor precision with modern texturizing techniques.</p>
      </div>

      <div class="service-groups-grid">
        <!-- Haircut Group -->
        <div class="service-category-card">
          <div>
            <div class="card-cat-title">
              <span>Cuts & Fades</span>
              <span class="tag">ESSENTIAL</span>
            </div>
            <ul class="price-item-list">
              <li class="price-item">
                <span class="price-name">Classic Haircut</span>
                <span class="price-amount">₹300</span>
              </li>
              <li class="price-item">
                <span class="price-name">Skin Fade / Taper Fade</span>
                <span class="price-amount">₹400</span>
              </li>
              <li class="price-item">
                <span class="price-name">Haircut + Beard Combo</span>
                <span class="price-amount">₹550</span>
              </li>
              <li class="price-item">
                <span class="price-name">Young Gentleman (Kids Cut)</span>
                <span class="price-amount">₹250</span>
              </li>
              <li class="price-item">
                <span class="price-name">Hair Wash, Conditioning & Style</span>
                <span class="price-amount">₹200</span>
              </li>
            </ul>
          </div>
          <div class="service-card-action">
            <a href="/book?service=Skin+Fade" class="btn btn-charcoal" style="width: 100%;">Book a Haircut</a>
          </div>
        </div>

        <!-- Beard Group -->
        <div class="service-category-card">
          <div>
            <div class="card-cat-title">
              <span>Beard & Shave</span>
              <span class="tag">RITUAL</span>
            </div>
            <ul class="price-item-list">
              <li class="price-item">
                <span class="price-name">Beard Trim & Clean Shape</span>
                <span class="price-amount">₹200</span>
              </li>
              <li class="price-item">
                <span class="price-name">Traditional Hot Towel Shave</span>
                <span class="price-amount">₹350</span>
              </li>
              <li class="price-item">
                <span class="price-name">Beard Colour & Grey Camouflage</span>
                <span class="price-amount">₹300</span>
              </li>
              <li class="price-item">
                <span class="price-name">Moustache Styling & Wax</span>
                <span class="price-amount">₹150</span>
              </li>
              <li class="price-item">
                <span class="price-name">Pre-Shave Oil Treatment</span>
                <span class="price-amount">₹150</span>
              </li>
            </ul>
          </div>
          <div class="service-card-action">
            <a href="/book?service=Hot+Towel+Shave" class="btn btn-charcoal" style="width: 100%;">Book Beard Care</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== SECTION 2: COLOUR & TREATMENTS (DARK THEME) ==================== -->
    <section class="services-catalog-section theme-dark" id="treatments">
      <div class="section-header-block">
        <span class="section-kicker">RESTORATIVE CARE</span>
        <h2 class="section-title">Colour & Botanical <span class="italic-serif">Hair Therapies</span></h2>
        <p class="section-desc">Designed to restore moisture balance, scalp health, and vibrant hair texture through professional formulations.</p>
      </div>

      <div class="service-groups-grid">
        <div class="service-category-card">
          <div>
            <div class="card-cat-title">
              <span>Colour & Highlights</span>
              <span class="tag">CREATIVE</span>
            </div>
            <ul class="price-item-list">
              <li class="price-item">
                <span class="price-name">Global Hair Colour</span>
                <span class="price-amount">₹1200</span>
              </li>
              <li class="price-item">
                <span class="price-name">Grey Coverage & Blending</span>
                <span class="price-amount">₹600</span>
              </li>
              <li class="price-item">
                <span class="price-name">Highlights / Balayage Accents</span>
                <span class="price-amount">₹1500</span>
              </li>
              <li class="price-item">
                <span class="price-name">Tonal Gloss & Shine Seal</span>
                <span class="price-amount">₹800</span>
              </li>
            </ul>
          </div>
          <div class="service-card-action">
            <a href="/book?service=Global+Colour" class="btn btn-gold" style="width: 100%;">Book Colour</a>
          </div>
        </div>

        <div class="service-category-card">
          <div>
            <div class="card-cat-title">
              <span>Scalp & Spa Therapies</span>
              <span class="tag">THERAPEUTIC</span>
            </div>
            <ul class="price-item-list">
              <li class="price-item">
                <span class="price-name">Intense Moisture Hair Spa</span>
                <span class="price-amount">₹800</span>
              </li>
              <li class="price-item">
                <span class="price-name">Anti-Dandruff Deep Detox</span>
                <span class="price-amount">₹1000</span>
              </li>
              <li class="price-item">
                <span class="price-name">Keratin Smooth Infusion</span>
                <span class="price-amount">₹2500</span>
              </li>
              <li class="price-item">
                <span class="price-name">Follicle Strengthening Treatment</span>
                <span class="price-amount">₹1200</span>
              </li>
            </ul>
          </div>
          <div class="service-card-action">
            <a href="/book?service=Hair+Spa" class="btn btn-gold" style="width: 100%;">Book Hair Spa</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== SECTION 3: SKIN & FACIALS ==================== -->
    <section class="services-catalog-section" id="skin-care">
      <div class="section-header-block">
        <span class="section-kicker">SKIN WELLNESS</span>
        <h2 class="section-title">Facial Architecture & <span class="italic-serif">Clean-Ups</span></h2>
        <p class="section-desc">Combat urban pollution, fatigue, and dullness with clinical yet restorative facial regimens.</p>
      </div>

      <div class="service-groups-grid">
        <div class="service-category-card">
          <div>
            <div class="card-cat-title">
              <span>Skin Rejuvenation</span>
              <span class="tag">GLOW</span>
            </div>
            <ul class="price-item-list">
              <li class="price-item">
                <span class="price-name">Urban Clean-Up</span>
                <span class="price-amount">₹600</span>
              </li>
              <li class="price-item">
                <span class="price-name">Signature Glow Facial</span>
                <span class="price-amount">₹1200</span>
              </li>
              <li class="price-item">
                <span class="price-name">Sun Protection De-Tan Therapy</span>
                <span class="price-amount">₹700</span>
              </li>
              <li class="price-item">
                <span class="price-name">Therapeutic Head Massage (20 mins)</span>
                <span class="price-amount">₹300</span>
              </li>
            </ul>
          </div>
          <div class="service-card-action">
            <a href="/book?service=Glow+Facial" class="btn btn-charcoal" style="width: 100%;">Book Facial</a>
          </div>
        </div>

        <div class="service-category-card">
          <div>
            <div class="card-cat-title">
              <span>Women's Hair & Beauty</span>
              <span class="tag">COUTURE</span>
            </div>
            <ul class="price-item-list">
              <li class="price-item">
                <span class="price-name">Women's Designer Haircut</span>
                <span class="price-amount">₹600</span>
              </li>
              <li class="price-item">
                <span class="price-name">Signature Bouncy Blow-Dry</span>
                <span class="price-amount">₹500</span>
              </li>
              <li class="price-item">
                <span class="price-name">Women's Global Colour</span>
                <span class="price-amount">₹2000</span>
              </li>
              <li class="price-item">
                <span class="price-name">Luxury Hydrating Facial</span>
                <span class="price-amount">₹1500</span>
              </li>
              <li class="price-item">
                <span class="price-name">Bridal Makeup & Styling</span>
                <span class="price-amount">from ₹8000</span>
              </li>
            </ul>
          </div>
          <div class="service-card-action">
            <a href="/women" class="btn btn-outline" style="width: 100%;">View Women's Details</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== CALL TO ACTION STRIP ==================== -->
    <section class="booking-cta-strip">
      <div class="cta-left">
        <span class="cta-kicker">CHAIR RESERVATION</span>
        <h2 class="cta-heading">Ready for a <span class="italic-serif">clean finish?</span></h2>
        <p class="cta-desc">Choose your artist, your service, and your preferred hour online. We look forward to welcoming you.</p>
      </div>
      <div>
        <a href="/book" class="btn btn-gold">Book Your Session</a>
      </div>
    </section>
  </main>
</BaseLayout>
