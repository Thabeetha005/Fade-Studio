---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact & Studio Hours — FADE STUDIO | Bengaluru"
  description="Visit FADE STUDIO in Indiranagar, Bengaluru. Opening hours Mon-Sun 10:00 AM - 9:00 PM. Contact us via phone, email, or online inquiry form."
  currentPage="contact"
  showPreloader={false}
>
  <main id="mainContent">

    <!-- ==================== HERO ==================== -->
    <section class="page-hero">
      <div class="page-hero-inner">
        <span class="page-kicker">CONCIERGE & ACCESS</span>
        <h1 class="page-hero-title">
          Get in <span class="italic-serif">touch.</span>
        </h1>
        <p class="page-hero-desc">
          Have an inquiry regarding wedding bookings, group sessions, or specific stylist availability? Our concierge desk is at your service seven days a week.
        </p>
      </div>
    </section>

    <!-- ==================== SECTION 1: CONTACT DETAILS & FORM ==================== -->
    <section class="content-section" id="contact-details">
      <div class="contact-layout">

        <!-- Left: Details Box -->
        <div class="contact-details-box">
          <div>
            <span class="contact-block-title">STUDIO ADDRESS</span>
            <p class="contact-block-value">
              14th Main Road, Indiranagar,<br>
              100 Feet Rd Junction, Bengaluru, KA 560038
            </p>
            <p style="font-size:12px; font-style:italic; color:#666; margin-top:6px;">
              Landmark: Opposite Costa Coffee, First Floor. Valet parking on ground floor.
            </p>
          </div>

          <div>
            <span class="contact-block-title">OPENING HOURS</span>
            <p class="contact-block-value" style="color:var(--color-gold);">
              Monday &ndash; Sunday<br>
              10:00 AM &ndash; 9:00 PM
            </p>
            <p style="font-size:12px; font-style:italic; color:#666; margin-top:6px;">
              Open on all major public holidays. Prior booking advised for evening peak hours.
            </p>
          </div>

          <div>
            <span class="contact-block-title">DIRECT CHANNELS</span>
            <p class="contact-block-value" style="font-size:20px;">
              Phone: <a href="tel:+919876543210" style="color:var(--color-charcoal);">+91 98765 43210</a><br>
              Email: <a href="mailto:concierge@fadestudio.in" style="color:var(--color-charcoal);">concierge@fadestudio.in</a>
            </p>
          </div>

          <div style="background:var(--color-ivory-light); border:1px solid var(--color-border); padding:24px;">
            <span style="font-family:var(--font-sans); font-size:10.5px; font-weight:700; color:var(--color-gold); letter-spacing:0.12em; text-transform:uppercase;">IMMEDIATE ASSISTANCE</span>
            <p style="font-size:12px; font-style:italic; margin-top:8px;">
              Looking for a last-minute slot today? Call our front desk directly at +91 98765 43210 for live chair updates.
            </p>
          </div>
        </div>

        <!-- Right: Inquiry Form -->
        <div class="form-card">
          <form id="contactForm">
            <span class="section-kicker">SEND A MESSAGE</span>
            <h2 style="font-family:var(--font-serif); font-size:32px; margin-bottom:20px;">Direct <span class="italic-serif">Inquiry</span></h2>

            <div class="form-grid">
              <div class="form-group">
                <label for="contactName" class="form-label">Your Name *</label>
                <input type="text" id="contactName" class="form-input" placeholder="e.g. Alok Verma" required>
              </div>

              <div class="form-group">
                <label for="contactEmail" class="form-label">Email Address *</label>
                <input type="email" id="contactEmail" class="form-input" placeholder="name@domain.com" required>
              </div>

              <div class="form-group col-span-2">
                <label for="contactPhone" class="form-label">Phone Number (Optional)</label>
                <input type="tel" id="contactPhone" class="form-input" placeholder="+91 98765 43210">
              </div>

              <div class="form-group col-span-2">
                <label for="contactSubject" class="form-label">Topic of Inquiry</label>
                <select id="contactSubject" class="form-select">
                  <option value="General Inquiry">General Service Inquiry</option>
                  <option value="Bridal or Event">Bridal or Groom Wedding Inquiry</option>
                  <option value="Stylist Consultation">Pre-Cut Stylist Advice</option>
                  <option value="Career & Press">Careers & Collaborations</option>
                </select>
              </div>

              <div class="form-group col-span-2">
                <label for="contactMessage" class="form-label">Your Message *</label>
                <textarea id="contactMessage" class="form-textarea" placeholder="Tell us how we can assist you..." required></textarea>
              </div>
            </div>

            <button type="submit" class="btn btn-charcoal" style="width: 100%;">
              Send Inquiry
            </button>
          </form>
        </div>

      </div>
    </section>

    <!-- ==================== SECTION 2: MAP & LOCATION ==================== -->
    <section class="content-section theme-dark" id="map-section">
      <div class="section-header-block">
        <span class="section-kicker">FINDING US</span>
        <h2 class="section-title">Studio <span class="italic-serif">Coordinates.</span></h2>
        <p class="section-desc">Conveniently situated in central Indiranagar with dedicated client parking.</p>
      </div>

      <div class="map-placeholder">
        <div class="map-pin-icon" aria-hidden="true">&#9678;</div>
        <h3 style="font-family:var(--font-serif); font-size:28px; color:var(--color-ivory);">FADE STUDIO INDIRANAGAR</h3>
        <p style="color:#D5D2CB; font-size:13px; max-width:480px; font-style:italic;">
          12.9784° N, 77.6408° E · 14th Main Road, 100 Feet Rd Junction, Bengaluru 560038
        </p>
        <div style="margin-top:16px;">
          <a href="https://maps.google.com" target="_blank" rel="noopener noreferrer" class="btn btn-gold">
            Open in Google Maps &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- ==================== SECTION 3: CAREERS & COLLABORATIONS ==================== -->
    <section class="content-section" id="careers-section">
      <div class="section-header-block">
        <span class="section-kicker">JOIN OUR ATELIER</span>
        <h2 class="section-title">Barbers & stylists <span class="italic-serif">wanted.</span></h2>
        <p class="section-desc">We are always eager to meet dedicated hair artists who take pride in disciplined razor work, continuous education, and genuine client hospitality.</p>
      </div>

      <div class="service-groups-grid">
        <div class="service-category-card">
          <div class="card-cat-title">
            <span>Barber Positions</span>
            <span class="tag">OPEN</span>
          </div>
          <p class="p-normal" style="font-size:12.5px; line-height:1.6; margin-bottom:16px;">
            Seeking barbers proficient in skin fading, classic shear work, and traditional hot towel straight-razor shaves. Minimum 3 years salon experience.
          </p>
          <a href="mailto:careers@fadestudio.in?subject=Barber+Application" class="btn btn-outline" style="width:100%;">Apply via Email</a>
        </div>

        <div class="service-category-card">
          <div class="card-cat-title">
            <span>Colour & Texture Specialists</span>
            <span class="tag">OPEN</span>
          </div>
          <p class="p-normal" style="font-size:12.5px; line-height:1.6; margin-bottom:16px;">
            Seeking creative directors and stylists with passion for balayage, keratin smoothing, and bridal styling. Competitive compensation and growth.
          </p>
          <a href="mailto:careers@fadestudio.in?subject=Stylist+Application" class="btn btn-outline" style="width:100%;">Apply via Email</a>
        </div>
      </div>
    </section>

    <!-- ==================== CALL TO ACTION STRIP ==================== -->
    <section class="booking-cta-strip">
      <div class="cta-left">
        <span class="cta-kicker">IMMEDIATE CHAIR ACCESS</span>
        <h2 class="cta-heading">Ready for a <span class="italic-serif">sharp look?</span></h2>
        <p class="cta-desc">Skip the wait and secure your preferred hour in advance.</p>
      </div>
      <div>
        <a href="/book" class="btn btn-gold">Book Appointment</a>
      </div>
    </section>
  </main>
</BaseLayout>
