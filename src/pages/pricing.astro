---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Pricing Table — FADE STUDIO | Transparent Grooming & Salon Rates"
  description="View the complete price list for FADE STUDIO in Indian Rupees (INR): haircuts, skin fades, beard grooming, hair spas, colour, facials, and wedding packages."
  currentPage="pricing"
  showPreloader={false}
>
  <main id="mainContent">

    <!-- ==================== HERO ==================== -->
    <section class="page-hero">
      <div class="page-hero-inner">
        <span class="page-kicker">PRICING DISCLOSURE</span>
        <h1 class="page-hero-title">
          No hidden costs. <span class="italic-serif">Honest value.</span>
        </h1>
        <p class="page-hero-desc">
          Every price listed is inclusive of wash, initial consultation, and styling products. All rates are in Indian Rupees (₹) with zero surcharges.
        </p>
        <div class="page-hero-cta">
          <a href="/book" class="btn btn-charcoal">Book Any Service</a>
          <a href="/offers" class="btn btn-outline">Check 15% First-Visit Offer</a>
        </div>
      </div>
    </section>

    <!-- ==================== SECTION 1: MEN'S HAIR & BEARD ==================== -->
    <section class="pricing-section" id="mens-pricing">
      <div class="section-header-block">
        <span class="section-kicker">CATEGORY 01</span>
        <h2 class="section-title">Men's Haircuts & <span class="italic-serif">Beard Disciplines</span></h2>
        <p class="section-desc">Straightforward pricing for precision barbering, taper fades, and clean shaves.</p>
      </div>

      <div class="service-groups-grid">
        <div class="service-category-card">
          <div class="card-cat-title">
            <span>Men's Haircuts</span>
            <span class="tag">ESSENTIALS</span>
          </div>
          <ul class="price-item-list">
            <li class="price-item">
              <span class="price-name">Haircut</span>
              <span class="price-amount">₹300</span>
            </li>
            <li class="price-item">
              <span class="price-name">Skin Fade / Taper Fade</span>
              <span class="price-amount">₹400</span>
            </li>
            <li class="price-item">
              <span class="price-name">Haircut + Beard</span>
              <span class="price-amount">₹550</span>
            </li>
            <li class="price-item">
              <span class="price-name">Kids Cut</span>
              <span class="price-amount">₹250</span>
            </li>
            <li class="price-item">
              <span class="price-name">Hair Wash & Style</span>
              <span class="price-amount">₹200</span>
            </li>
          </ul>
          <div class="service-card-action">
            <a href="/book?service=Skin+Fade" class="btn btn-charcoal" style="width:100%;">Book a Haircut</a>
          </div>
        </div>

        <div class="service-category-card">
          <div class="card-cat-title">
            <span>Beard & Shave</span>
            <span class="tag">HOT TOWEL</span>
          </div>
          <ul class="price-item-list">
            <li class="price-item">
              <span class="price-name">Beard Trim & Shape</span>
              <span class="price-amount">₹200</span>
            </li>
            <li class="price-item">
              <span class="price-name">Hot Towel Shave</span>
              <span class="price-amount">₹350</span>
            </li>
            <li class="price-item">
              <span class="price-name">Beard Colour</span>
              <span class="price-amount">₹300</span>
            </li>
            <li class="price-item">
              <span class="price-name">Beard Trim + Head Massage</span>
              <span class="price-amount">₹450</span>
            </li>
            <li class="price-item">
              <span class="price-name">Razor Neck Line Clean</span>
              <span class="price-amount">₹150</span>
            </li>
          </ul>
          <div class="service-card-action">
            <a href="/book?service=Hot+Towel+Shave" class="btn btn-charcoal" style="width:100%;">Book Beard Care</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== SECTION 2: COLOUR & SKIN TREATMENTS (DARK THEME) ==================== -->
    <section class="pricing-section theme-dark" id="treatments-pricing">
      <div class="section-header-block">
        <span class="section-kicker">CATEGORY 02</span>
        <h2 class="section-title">Colour, Scalp & <span class="italic-serif">Skin Architecture</span></h2>
        <p class="section-desc">Clinical facials, botanical deep-conditioning spas, and ammonia-free global colour.</p>
      </div>

      <div class="service-groups-grid">
        <div class="service-category-card">
          <div class="card-cat-title">
            <span>Colour & Scalp Treatments</span>
            <span class="tag">RESTORATIVE</span>
          </div>
          <ul class="price-item-list">
            <li class="price-item">
              <span class="price-name">Global Colour</span>
              <span class="price-amount">₹1200</span>
            </li>
            <li class="price-item">
              <span class="price-name">Grey Cover</span>
              <span class="price-amount">₹600</span>
            </li>
            <li class="price-item">
              <span class="price-name">Highlights</span>
              <span class="price-amount">₹1500</span>
            </li>
            <li class="price-item">
              <span class="price-name">Hair Spa</span>
              <span class="price-amount">₹800</span>
            </li>
            <li class="price-item">
              <span class="price-name">Anti-Dandruff Treatment</span>
              <span class="price-amount">₹1000</span>
            </li>
          </ul>
          <div class="service-card-action">
            <a href="/book?service=Hair+Spa" class="btn btn-gold" style="width:100%;">Book Treatment</a>
          </div>
        </div>

        <div class="service-category-card">
          <div class="card-cat-title">
            <span>Skin & Face Care</span>
            <span class="tag">WELLNESS</span>
          </div>
          <ul class="price-item-list">
            <li class="price-item">
              <span class="price-name">Clean-Up</span>
              <span class="price-amount">₹600</span>
            </li>
            <li class="price-item">
              <span class="price-name">Glow Facial</span>
              <span class="price-amount">₹1200</span>
            </li>
            <li class="price-item">
              <span class="price-name">De-Tan</span>
              <span class="price-amount">₹700</span>
            </li>
            <li class="price-item">
              <span class="price-name">Head Massage</span>
              <span class="price-amount">₹300</span>
            </li>
            <li class="price-item">
              <span class="price-name">Express Eye Revival</span>
              <span class="price-amount">₹400</span>
            </li>
          </ul>
          <div class="service-card-action">
            <a href="/book?service=Glow+Facial" class="btn btn-gold" style="width:100%;">Book Skin Care</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== SECTION 3: WOMEN'S & PACKAGES ==================== -->
    <section class="pricing-section" id="packages">
      <div class="section-header-block">
        <span class="section-kicker">CATEGORY 03</span>
        <h2 class="section-title">Women's Salon & <span class="italic-serif">Groom Packages</span></h2>
        <p class="section-desc">Transparent pricing for women's couture styling and comprehensive groom packages.</p>
      </div>

      <div class="service-groups-grid">
        <div class="service-category-card">
          <div class="card-cat-title">
            <span>Women's Services</span>
            <span class="tag">SALON</span>
          </div>
          <ul class="price-item-list">
            <li class="price-item">
              <span class="price-name">Haircut</span>
              <span class="price-amount">₹600</span>
            </li>
            <li class="price-item">
              <span class="price-name">Blow-Dry</span>
              <span class="price-amount">₹500</span>
            </li>
            <li class="price-item">
              <span class="price-name">Colour</span>
              <span class="price-amount">₹2000</span>
            </li>
            <li class="price-item">
              <span class="price-name">Facial</span>
              <span class="price-amount">₹1500</span>
            </li>
            <li class="price-item">
              <span class="price-name">Bridal Makeup</span>
              <span class="price-amount">from ₹8000</span>
            </li>
          </ul>
          <div class="service-card-action">
            <a href="/women" class="btn btn-charcoal" style="width:100%;">Explore Women's Salon</a>
          </div>
        </div>

        <div class="service-category-card" style="border: 2px solid var(--color-gold);">
          <div class="card-cat-title">
            <span>Special Bundles</span>
            <span class="tag" style="background:var(--color-gold); color:var(--color-charcoal-dark); padding:2px 8px;">VALUE</span>
          </div>
          <ul class="price-item-list">
            <li class="price-item" style="flex-direction:column; align-items:flex-start; gap:4px;">
              <div style="display:flex; justify-content:space-between; width:100%;">
                <span class="price-name">The Groom Package</span>
                <span class="price-amount" style="color:var(--color-gold);">₹3500</span>
              </div>
              <p class="form-help">Includes: Master haircut, beard trim & lineup, glow facial, and hair spa.</p>
            </li>
            <li class="price-item" style="flex-direction:column; align-items:flex-start; gap:4px;">
              <div style="display:flex; justify-content:space-between; width:100%;">
                <span class="price-name">Bridal Package</span>
                <span class="price-amount" style="color:var(--color-gold);">On Request</span>
              </div>
              <p class="form-help">Custom tailored hair updo, HD makeup, skin prep, and veil draping.</p>
            </li>
            <li class="price-item" style="flex-direction:column; align-items:flex-start; gap:4px;">
              <div style="display:flex; justify-content:space-between; width:100%;">
                <span class="price-name">Executive Refresh</span>
                <span class="price-amount">₹850</span>
              </div>
              <p class="form-help">Haircut + Beard Trim + 20-min Head Massage.</p>
            </li>
          </ul>
          <div class="service-card-action">
            <a href="/book?service=Groom+Package" class="btn btn-gold" style="width:100%;">Book Package</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== CALL TO ACTION STRIP ==================== -->
    <section class="booking-cta-strip">
      <div class="booking-cta-inner">
        <div class="cta-left">
          <span class="cta-kicker">PRICING TRANSPARENCY</span>
          <h2 class="cta-heading">Ready for your <span class="italic-serif">session?</span></h2>
          <p class="cta-desc">Lock in your time slot online. Cash, cards, and UPI accepted at front desk.</p>
        </div>
        <div>
          <a href="/book" class="btn btn-gold">Book Online Now</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
