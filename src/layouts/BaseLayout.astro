---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Drawer from '../components/Drawer.astro';
import Popup from '../components/Popup.astro';
import Preloader from '../components/Preloader.astro';
import { WHATSAPP_URL } from '../config.js';

export interface Props {
  title?: string;
  description?: string;
  currentPage?: string;
  showPreloader?: boolean;
}

const {
  title = 'FADE STUDIO — Unisex Grooming & Hair Studio | Cut Clean. Look Sharp.',
  description = "A modern grooming and hair studio for men and women. Precision skin fades, beard sculpting, hair treatments, and women's styling.",
  currentPage = '',
  showPreloader = false
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <!-- Google Fonts: Instrument Serif & Urbanist -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Urbanist:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">
</head>
<body>

  {showPreloader && <Preloader />}

  <Navbar currentPage={currentPage} />
  <Drawer currentPage={currentPage} />

  <slot />

  <Footer />

  <Popup />

  <!-- Back to Top Button -->
  <button id="backToTopBtn" class="back-to-top" aria-label="Back to top">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>

  <!-- Global Config -->
  <script is:inline define:vars={{ WHATSAPP_URL }}>
    window.FADE_WHATSAPP_URL = WHATSAPP_URL;
  </script>

  <!-- CDN Dependencies -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  <script src="../scripts/main.js"></script>
</body>
</html>
